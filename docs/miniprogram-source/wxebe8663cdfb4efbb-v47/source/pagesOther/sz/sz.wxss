.container .user {
    background: #fff;
    border: 1rpx solid #1f5fde;
    border-radius: 10rpx;
    box-shadow: 0 10rpx 18rpx 2rpx rgba(78,134,247,.15);
    box-sizing: border-box;
    margin: 40rpx;
    padding: 60rpx 52rpx
}

.container .user .box {
    color: #333;
    display: -webkit-flex;
    display: flex;
    font-family: PingFang SC;
    font-size: 28rpx;
    font-weight: 400;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.container .user .box:nth-child(1) {
    margin-bottom: 50rpx
}

.container .user .box .img {
    height: 28rpx;
    margin-left: 10rpx;
    width: 28rpx
}

.container .user .box .font {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex
}

.container .logon {
    background: #4e86f7;
    border-radius: 10rpx;
    bottom: 80rpx;
    box-shadow: 0 10rpx 18rpx 2rpx rgba(78,134,247,.2);
    color: #fcfefc;
    font-family: PingFang SC;
    font-size: 28rpx;
    font-weight: 400;
    height: 88rpx;
    left: 40rpx;
    line-height: 88rpx;
    position: fixed;
    right: 40rpx;
    text-align: center
}
