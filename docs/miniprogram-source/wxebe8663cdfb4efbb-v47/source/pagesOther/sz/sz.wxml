<view class="container">
    <view class="user">
        <view class="box">
            <view>姓名</view>
            <view>{{userObj.name}}</view>
        </view>
        <view class="box">
            <view class="font">手机号码</view>
            <view class="font">{{userObj.phone+''}}</view>
        </view>
    </view>
    <view bindtap="__e" class="logon" data-event-opts="{{[ [ 'tap',[ [ 'onLogin',['$event'] ] ] ] ]}}">退出</view>
</view>
