.content {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column;
    padding-top: 20rpx
}

.empty-image {
    height: 320rpx;
    margin: 200rpx 0rpx 0rpx;
    width: 550rpx
}

.empty-text {
    color: #666;
    font-size: 28rpx;
    font-weight: 400;
    margin-top: 60rpx
}

.car-view {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    border: 1rpx solid #4e86f7;
    border-radius: 10px;
    margin-top: 20rpx;
    width: 690rpx
}

.car-view,.car-view .info-view {
    display: -webkit-flex;
    display: flex
}

.car-view .info-view {
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column
}

.car-view .info-view .type-view {
    color: #397eff;
    font-size: 28rpx;
    font-weight: 400;
    margin: 30rpx 30rpx 0rpx 20rpx
}

.car-view .info-view .cphm-view {
    color: #383838;
    font-size: 34rpx;
    font-weight: 500;
    margin: 0rpx 30rpx 30rpx 20rpx
}

.car-view .operate-button {
    -webkit-align-items: center;
    align-items: center;
    border: 1rpx solid #dcdcdc;
    border-radius: 10rpx;
    color: #f1863e;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    font-weight: 400;
    height: 60rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin-right: 20rpx;
    width: 160rpx
}

.car-view .cancel-button {
    color: #f1863e
}

.car-view .edit-button {
    color: #397eff
}

.text-tip {
    color: #999;
    font-size: 24rpx;
    font-weight: 400;
    margin: 40rpx 50rpx
}

.text-tip-warn {
    color: #cb4046
}

.add-button {
    -webkit-align-items: center;
    align-items: center;
    background: #4e86f7;
    border-radius: 10px;
    box-shadow: 0 10px 18px 2px rgba(78,134,247,.2);
    color: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    height: 88rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 40rpx
}

.add-button-disable {
    background: #b5b5b5
}
