<view class="container">
    <view class="content" wx:if="{{showEmpty}}">
        <image class="empty-image" mode="aspectFit" src="/static/common/empty.png"></image>
        <view class="empty-text">{{loaded?'暂无绑定车辆':'正在加载中'}}</view>
    </view>
    <view class="content" wx:else>
        <view bindtap="__e" class="car-view" data-event-opts="{{[ [ 'tap',[ [ 'carDetailAction',['$0'],[ [ ['carList','',index] ] ] ] ] ] ]}}" wx:for="{{$root.l0}}" wx:key="index">
            <view class="info-view">
                <view class="type-view">{{item[$orig].cllxmc}}</view>
                <view class="cphm-view">{{item.g0}}</view>
            </view>
            <view catchtap="__e" class="operate-button cancel-button" data-event-opts="{{[ [ 'tap',[ [ 'cancelAction',['$0'],[ [ ['carList','',index] ] ] ] ] ] ]}}">解除绑定</view>
            <view catchtap="__e" class="operate-button edit-button" data-event-opts="{{[ [ 'tap',[ [ 'carEditAction',['$0'],[ [ ['carList','',index] ] ] ] ] ] ]}}">修改信息</view>
        </view>
        <view class="text-tip text-tip-warn" wx:if="{{$root.g1>=3}}">温馨提示：您已经绑定3辆车，无法继续添加车辆，如需要新增车辆，请对现有的车辆进行解除绑定操作！</view>
        <view class="text-tip" wx:else>{{'温馨提示：最多可绑定'+(number||0)+'辆车'}}</view>
    </view>
    <view class="add-button add-button-disable" wx:if="{{$root.g2>=number}}">添加车辆</view>
    <view bindtap="__e" class="add-button" data-event-opts="{{[ [ 'tap',[ [ 'addCarAction',['$event'] ] ] ] ]}}" wx:else>添加车辆</view>
    <uni-popup bind:__l="__l" class="vue-ref" data-ref="popupDialog" type="dialog" vueId="39da9fdc-1" vueSlots="{{['default']}}">
        <uni-popup-dialog bind:__l="__l" bind:confirm="__e" content="确定要解除绑定吗？" data-event-opts="{{[ [ '^confirm',[ ['dialogConfirm'] ] ] ]}}" title="提示" type="info" vueId="{{'39da9fdc-2'+','+'39da9fdc-1'}}"></uni-popup-dialog>
    </uni-popup>
</view>
