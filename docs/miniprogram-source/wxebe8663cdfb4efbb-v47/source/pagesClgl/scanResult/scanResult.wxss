.view {
    background-color: #fff;
    margin-top: 20rpx
}

.seperator {
    background-color: #e1e1e1;
    height: 1rpx
}

.scan-image {
    margin: 20rpx 45rpx
}

.item-view {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 88rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.item-view .left-text {
    color: #333;
    font-size: 28rpx;
    margin-left: 20rpx
}

.item-view .right-text {
    color: #666;
    font-size: 28rpx;
    margin-right: 20rpx;
    text-align: right
}

.pop-content {
    position: relative
}

.pop-content,.pop-content .pop-center {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column
}

.pop-content .pop-center {
    background-color: #fff;
    border-radius: 10rpx;
    box-shadow: 0rpx 2rpx 20rpx 0rpx hsla(0,0%,56%,.2);
    margin-bottom: 130rpx;
    width: 590rpx
}

.pop-content .pop-center .pop-title {
    color: #333;
    font-size: 28rpx;
    font-weight: 400;
    margin-top: 50rpx
}

.pop-content .pop-center .pop-input {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    margin-top: 30rpx
}

.pop-content .pop-center .pop-input .pop-input-item {
    -webkit-align-items: center;
    align-items: center;
    background: #f8f8f8;
    border: 1rpx solid #cdcdcd;
    border-radius: 4rpx;
    color: #333;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    height: 70rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin-left: 2rpx;
    width: 50rpx
}

.pop-content .pop-center .pop-input .pop-input-item-num {
    margin-left: 40rpx
}

.pop-content .pop-center .pop-input .pop-input-item-current {
    border: 1rpx solid #4e86f7
}

.pop-content .pop-center .pop-operation {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    margin-top: 30rpx;
    width: 100%
}

.pop-content .pop-center .pop-operation .pop-cancel-button {
    color: #333;
    height: 90rpx
}

.pop-content .pop-center .pop-operation .pop-cancel-button,.pop-content .pop-center .pop-operation .pop-confirm-button {
    -webkit-align-items: center;
    align-items: center;
    border-top: 1rpx solid #cdcdcd;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    font-size: 28rpx;
    -webkit-justify-content: center;
    justify-content: center
}

.pop-content .pop-center .pop-operation .pop-confirm-button {
    border-left: 1rpx solid #cdcdcd;
    color: #4e86f7
}

.pop-content .rightItem {
    -webkit-align-items: center;
    align-items: center;
    background-color: #e5e5e5;
    bottom: 90rpx;
    display: -webkit-flex;
    display: flex;
    height: 70rpx;
    -webkit-justify-content: center;
    justify-content: center;
    position: absolute;
    right: 20rpx;
    width: 90rpx
}

.pop-content .rightItem .img {
    height: 30rpx;
    width: 46rpx
}

.pop-content .pop-board {
    background-color: #fff;
    border-radius: 30rpx 30rpx 0 0;
    width: 100%
}

.pop-content .pop-board .toolbar {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: flex-end;
    justify-content: flex-end
}

.pop-content .pop-board .toolbar .cancel-button {
    color: #999;
    font-size: 30rpx;
    font-weight: 400;
    margin: 20rpx 0rpx 20rpx 15rpx;
    padding: 20rpx 15rpx
}

.pop-content .pop-board .toolbar .confirm-button {
    color: #999;
    font-size: 30rpx;
    font-weight: 400;
    margin: 20rpx 15rpx 20rpx 0rpx;
    padding: 20rpx 15rpx
}

.pop-content .pop-board .board-content {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    margin: 0rpx 20rpx 60rpx
}

.pop-content .pop-board .board-content .board-item {
    -webkit-align-items: center;
    align-items: center;
    background-color: #f8f8f8;
    border-radius: 4rpx;
    color: #333;
    display: -webkit-flex;
    display: flex;
    font-size: 36rpx;
    height: 70rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 0rpx 13rpx 30rpx 0rpx;
    width: 58rpx
}

.pop-content .pop-board .board-content .board-item:nth-child(10n) {
    margin-right: 0rpx
}

.view-bottom {
    -webkit-align-items: center;
    align-items: center;
    bottom: 0rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    left: 0rpx;
    position: absolute;
    right: 0rpx
}

.view-bottom .left-button {
    background: #b5b5b5;
    box-shadow: 0rpx 5rpx 18rpx 2rpx hsla(0,0%,51%,.2)
}

.view-bottom .left-button,.view-bottom .right-button {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 10rpx;
    color: #fff;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    font-size: 32rpx;
    height: 88rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 38rpx
}

.view-bottom .right-button {
    background: #4e86f7;
    box-shadow: 0rpx 10rpx 18rpx 2rpx rgba(78,134,247,.2)
}

.cllx-content {
    background-color: #fff;
    border-radius: 30rpx 30rpx 0 0;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    max-height: 320rpx
}

.cllx-content .hphm-content-acive {
    color: #0587f9
}

.cllx-content .hphm-content {
    box-sizing: border-box;
    color: #333;
    font-family: PingFang SC;
    font-size: 32rpx;
    font-weight: 400;
    height: 130rpx;
    line-height: 130rpx;
    margin: 0 38rpx;
    text-align: center
}

.cllx-content .hphm-content:nth-child(1) {
    border-bottom: 1rpx solid #d2d2d2
}
