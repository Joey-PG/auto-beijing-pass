<view class="container">
    <scroll-view class="scroll" scrollY="true">
        <view class="jsy-view">
            <view class="jsy-section">
                <view class="jsy-line"></view>
                <view class="jsy-title" style="display:flex;justify-content:space-between;align-items:center;">
                    <view>车辆信息</view>
                </view>
                <view bindtap="__e" class="scan-button" data-event-opts="{{[ [ 'tap',[ ['scanAction'] ] ] ]}}" wx:if="{{isShow==1}}">
                    <image class="scan-image" mode="aspectFit" src="/pagesClgl/static/sqbz-scan.png"></image>
                    <text class="scan-text">智能识读</text>
                </view>
            </view>
            <view class="input-content">
                <view class="input-seperator"></view>
                <view class="input-item">
                    <text class="input-item-title">号牌号码：</text>
                    <view bindtap="__e" class="{{['input-item-detail',$root.g0==0?'font':'']}}" data-event-opts="{{[ [ 'tap',[ ['cphmAction'] ] ] ]}}">{{''+($root.g1?hphm:'请输入号牌号码')+''}}<uni-icons bind:__l="__l" class="forward" color="#999" size="15" type="forward" vueId="46cc488e-1"></uni-icons>
                    </view>
                </view>
                <view class="input-seperator-line"></view>
                <view class="input-item">
                    <text class="input-item-title">号牌种类：</text>
                    <view bindtap="__e" class="{{['input-item-detail',$root.g2==0?'font':'']}}" data-event-opts="{{[ [ 'tap',[ ['hpzlAction'] ] ] ]}}">{{''+($root.g3?hpzlmc:'请选择号牌种类')+''}}<uni-icons bind:__l="__l" class="forward" color="#999" size="15" type="forward" vueId="46cc488e-2"></uni-icons>
                    </view>
                </view>
                <view class="input-seperator-line"></view>
                <view class="input-item">
                    <text class="input-item-title">发动机号：</text>
                    <input bindblur="__e" bindinput="__e" class="input-item-detail" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '','fdjh','$event',['trim'] ] ],[ 'vinInput',['$event'] ] ] ],[ 'blur',[ ['$forceUpdate'] ] ] ]}}" maxlength="6" placeholder="请输入后6位字母数字，若无则填“无”" placeholderClass="grey-text" type="text" value="{{fdjh}}"></input>
                </view>
                <view class="input-seperator-line"></view>
                <view class="input-item">
                    <text class="input-item-title">品牌型号：</text>
                    <input bindblur="__e" bindinput="__e" class="input-item-detail" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '','ppxh','$event',['trim'] ] ],[ 'vinInput1',['$event'] ] ] ],[ 'blur',[ ['$forceUpdate'] ] ] ]}}" maxlength="32" placeholder="请输入字母数字，忽略大小写和其它字符" placeholderClass="grey-text" type="text" value="{{ppxh}}"></input>
                </view>
                <view class="input-seperator-line"></view>
                <view class="input-item">
                    <text class="input-item-title">注册日期：</text>
                    <picker bindchange="__e" data-event-opts="{{[ [ 'change',[ [ 'bindDateChange',['$event'] ] ] ] ]}}" end="{{endDate}}" mode="date" value="{{zcsj}}">
                        <view class="{{['input-item-detail',$root.g4==0?'font':'']}}">{{''+($root.g5?zcsj:'请按行驶证选择车辆注册日期')+''}}<uni-icons bind:__l="__l" class="forward" color="#999" size="15" type="forward" vueId="46cc488e-3"></uni-icons>
                        </view>
                    </picker>
                </view>
                <view class="input-seperator-line"></view>
                <view class="input-item">
                    <view bindtap="__e" data-event-opts="{{[ [ 'tap',[ [ 'goCllx',['$event'] ] ] ] ]}}" style="display:flex;align-items:center;">
                        <text class="input-item-title">车辆类型</text>
                        <image mode="aspectFit" src="/pagesClgl/static/tjcl-tip.png" style="width:24rpx;height:24rpx;margin:10rpx;"></image>
                        <text>：</text>
                    </view>
                    <view bindtap="__e" class="{{['input-item-detail',$root.g6==0?'font':'']}}" data-event-opts="{{[ [ 'tap',[ ['cllxAction'] ] ] ]}}">{{''+($root.g7?cllxmc:'请选择车辆类型')+''}}<uni-icons bind:__l="__l" class="forward" color="#999" size="15" type="forward" vueId="46cc488e-4"></uni-icons>
                    </view>
                </view>
                <block wx:if="{{cllxmc==='货车'}}">
                    <view class="input-seperator-line"></view>
                    <view class="input-item">
                        <view style="display:flex;align-items:center;">
                            <text class="input-item-title">车辆类型明细：</text>
                        </view>
                        <view bindtap="__e" class="{{['input-item-detail',$root.g8==0?'font':'']}}" data-event-opts="{{[ [ 'tap',[ ['cllxDetail'] ] ] ]}}">{{''+($root.g9?kz4:'请选择行驶证载明的车辆类型')+''}}<uni-icons bind:__l="__l" class="forward" color="#999" size="15" type="forward" vueId="46cc488e-5"></uni-icons>
                        </view>
                    </view>
                </block>
                <view class="input-seperator"></view>
            </view>
        </view>
        <view class="tip-view">
            <text class="tip-title">信息填写图示</text>
            <image bindtap="__e" class="tip-image" data-event-opts="{{[ [ 'tap',[ [ 'clickImg',['$event'] ] ] ] ]}}" mode="widthFix" src="/pagesClgl/static/tjcl_tip_demo.png"></image>
            <view bindtap="__e" class="tip-bg" data-event-opts="{{[ [ 'tap',[ [ 'goZcgd',['$event'] ] ] ] ]}}">
                <text class="tip-text blue-text">车辆环保等级影响进京证办理，查看详细规定</text>
                <image class="tip-image-1" mode="aspectFit" src="/pagesClgl/static/tjcl_tip_1.png"></image>
            </view>
            <view class="tip-bg-1">
                <image class="tip-image-2" mode="aspectFit" src="/pagesClgl/static/tjcl_tip_2.png"></image>
                <text class="tip-text yellow-text">进口车辆品牌型号请查询机动车登记证书或尝试
填写车辆识别代码的前8位</text>
            </view>
        </view>
        <view class="rule-image">
            <view>温馨提示:</view>
            <view>
                <text style="color:red;">*</text>1. 请注意区别车架号和发动机号。</view>
            <view>
                <text style="color:red;">*</text>2. 车辆号牌号码、发动机号及品牌型号在输入过程中请仔细区分“D、0和O”，“Z和2”，“5和S”，“1、i和l”等易混淆字符。</view>
            <view>
                <text style="color:red;">*</text>3. 发动机号及品牌型号在输入过程中如遇*、-、_或空格等特殊字符，请直接略过，只输入数字和字母，且不区分大小写。</view>
            <view>
                <text style="color:red;">*</text>4. 发动机号只需输入后6位即可，不足6位则输入全部。如：发动机号为JLB-4G13T，输入B4G13T即可。</view>
            <view>
                <text style="color:red;">*</text>5. 发动机号登记为“无”的，请填写“无”。</view>
            <view>
                <text style="color:red;">*</text>6. 号牌种类需根据号牌颜色手动选择。</view>
            <view>
                <text style="color:red;">*</text>7. 车辆类型依据<text bindtap="__e" data-event-opts="{{[ [ 'tap',[ [ 'goCllx',['$event'] ] ] ] ]}}" style="color:#007AFF;">车辆类型说明</text>进行选择客车、货车。</view>
        </view>
    </scroll-view>
    <button bindtap="__e" class="next-button" data-event-opts="{{[ [ 'tap',[ [ 'tjclAction',['$event'] ] ] ] ]}}" disabled="{{isAdd}}">添加车辆</button>
    <uni-popup bind:__l="__l" class="vue-ref" data-ref="hpzl" type="bottom" vueId="46cc488e-6" vueSlots="{{['default']}}">
        <view class="hphm-content">
            <view class="hphm-top">
                <view class="hphm-title">请根据车牌颜色选择号牌种类</view>
            </view>
            <view class="hphm-tip">系统无法为临时号牌和近期新登记注册号牌的机动车提供进京证办理服务</view>
            <scroll-view class="hphm-scroll" scrollY="{{true}}">
                <view class="hphm-item-container" wx:for="{{hpzlList}}">
                    <view bindtap="__e" class="hphm-item" data-event-opts="{{[ [ 'tap',[ [ 'hpzlSelectAction',['$0'],[ [ ['hpzlList','',index] ] ] ] ] ] ]}}">
                        <view class="hphm-item-left">
                            <image class="hphm-item-left-image" mode="aspectFit" src="{{item.imageUrl}}"></image>
                            <view class="hphm-item-left-text">{{item.tip}}</view>
                        </view>
                        <view class="hphm-item-right">{{item.zdz}}</view>
                    </view>
                    <view class="hphm-item-selected" wx:if="{{item.zdbm==hpzl}}">
                        <image class="item_image_selected" mode="aspectFill" src="/pagesClgl/static/hpzl_selected.png"></image>
                    </view>
                </view>
            </scroll-view>
        </view>
    </uni-popup>
    <uni-popup bind:__l="__l" class="vue-ref" data-ref="popup" type="bottom" vueId="46cc488e-7" vueSlots="{{['default']}}">
        <view class="pop-content">
            <view class="pop-center">
                <text class="pop-title">请输入车牌号</text>
                <view class="pop-input">
                    <view bindtap="__e" class="{{[ (_ind==2?'pop-input-item pop-input-item-num':'pop-input-item')+(index.g10?' pop-input-item-current':'') ]}}" data-event-opts="{{[ [ 'tap',[ [ 'goHideJia',[_ind] ] ] ] ]}}" wx:for="{{$root.l0}}" wx:for-index="_ind" wx:for-item="index">{{''+(index.g11?'+':index.g12)+''}}</view>
                </view>
                <view class="pop-operation">
                    <view bindtap="__e" class="pop-cancel-button" data-event-opts="{{[ [ 'tap',[ ['cancelAction'] ] ] ]}}">取消</view>
                    <view bindtap="__e" class="pop-confirm-button" data-event-opts="{{[ [ 'tap',[ ['confirmAction'] ] ] ]}}">确定</view>
                </view>
            </view>
            <view class="pop-board">
                <view class="toolbar">
                    <view bindtap="__e" class="confirm-button" data-event-opts="{{[ [ 'tap',[ [ 'confirmAction',['$event'] ] ] ] ]}}">完成</view>
                </view>
                <view class="board-content">
                    <block wx:if="{{$root.g13==0}}">
                        <view bindtap="__e" class="board-item" data-event-opts="{{[ [ 'tap',[ [ 'keyClick',['$0'],[ [ ['inputAreaItems','',index] ] ] ] ] ] ]}}" wx:for="{{inputAreaItems}}">{{''+item+''}}</view>
                    </block>
                    <block wx:else>
                        <view bindtap="__e" class="board-item" data-event-opts="{{[ [ 'tap',[ [ 'keyClick',['$0'],[ [ ['inputHeadItems','',index] ] ] ] ] ] ]}}" wx:for="{{inputHeadItems}}">{{''+item+''}}</view>
                        <view bindtap="__e" class="rightItem" data-event-opts="{{[ [ 'tap',[ ['deleteAction'] ] ] ]}}">
                            <image class="img" src="../static/del.png"></image>
                        </view>
                    </block>
                </view>
            </view>
        </view>
    </uni-popup>
    <uni-popup bind:__l="__l" class="vue-ref" data-ref="cllx" type="bottom" vueId="46cc488e-8" vueSlots="{{['default']}}">
        <view class="cllx-content">
            <view class="hphm-content" wx:for="{{typeList}}">
                <view bindtap="__e" class="{{[active==index?'hphm-content-acive':'','cllx-box']}}" data-event-opts="{{[ [ 'tap',[ [ 'cllxSelectAction',['$0',index],[ [ ['typeList','',index] ] ] ] ] ] ]}}">{{''+item.zdz+''}}</view>
            </view>
        </view>
    </uni-popup>
</view>
