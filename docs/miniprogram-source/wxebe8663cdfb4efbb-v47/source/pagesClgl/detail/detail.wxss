.section {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 100rpx
}

.section .line {
    background: #4e86f7;
    height: 30rpx;
    width: 6rpx
}

.section .title {
    color: #333;
    font-size: 32rpx;
    font-weight: 400;
    margin-left: 23rpx
}

.content {
    background-color: #fff
}

.content .seperator {
    background-color: #e1e1e1;
    height: 1rpx;
    width: 100%
}

.content .item {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 90rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.content .item .title {
    color: #333;
    font-size: 28rpx;
    font-weight: 400;
    margin-left: 30rpx
}

.content .item .detail {
    color: #999;
    font-size: 28rpx;
    font-weight: 400;
    margin-right: 30rpx
}
