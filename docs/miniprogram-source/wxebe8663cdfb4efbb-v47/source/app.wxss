@charset "UTF-8";

page {
    height: 100%;
    width: 100%
}

.container {
    background-color: #f8f8f8;
    height: 100%;
    width: 100%
}

.container,page {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column
}

page {
    overflow: hidden
}

body > wx-view {
    -webkit-flex: 1;
    flex: 1;
    overflow-y: auto
}

body .bottom-view,body::after {
    background: #f8f8f8;
    color: grey;
    content: "本服务由北京市公安局交通管理局提供";
    display: block;
    font-size: 24rpx;
    left: 0;
    padding: 5px;
    position: inherit;
    right: 0;
    text-align: center;
    z-index: 1
}

body .bottom-view {
    position: fixed
}

[bind-data-custom-hidden="true"],[data-custom-hidden="true"] {
    display: none!important
}
