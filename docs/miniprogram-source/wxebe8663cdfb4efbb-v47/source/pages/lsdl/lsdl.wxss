    flex: 1;
    font-size: 32rpx;
    font-weight: 400;
    margin-left: 20rpx
}

.scroll .jsy-section .scan-button {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    border: 1rpx solid #4e86f7;
    border-radius: 10rpx;
    border-radius: 5rpx;
    display: -webkit-flex;
    display: flex;
    height: 52rpx;
    margin-right: 20rpx
}

.scroll .jsy-section .scan-button .scan-image {
    height: 30rpx;
    margin-left: 15rpx;
    margin-right: 15rpx;
    width: 30rpx
