    -webkit-flex: 1;
    flex: 1
}

.scroll .txr-section .txr-button {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 52rpx;
    margin-right: 20rpx
}

.scroll .txr-section .txr-button .txr-image {
    height: 30rpx;
    margin-left: 15rpx;
