.scroll .input-content {
    background: #fff
}

.scroll .input-content .input-seperator {
    background-color: #e1e1e1;
    height: 1rpx;
    margin-left: 0rpx;
    margin-right: 0rpx
}

.scroll .input-content .input-seperator-line {
    background-color: #e1e1e1;
    height: 15rpx;
    margin-right: 0rpx
}

.scroll .input-content .input-item {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 90rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.scroll .input-content .input-item .input-important {
    color: #df3d33
}

.scroll .input-content .input-item .input-item-title {
    color: #333;
    font-size: 28rpx;
    font-weight: 400;
    margin-left: 30rpx
}

.scroll .input-content .input-item .input-item-detail {
    color: #999;
    -webkit-flex: 1;
    flex: 1;
    font-size: 28rpx;
    font-weight: 400;
    margin-right: 30rpx;
    text-align: right
}

.scroll .input-content-txr {
    margin-bottom: 20rpx
}

.scroll .vert-view {
    height: 80rpx;
    margin: 0 20rpx;
    width: 160rpx
}

.scroll .vert-view .vert-image {
    height: 100%;
    width: 100%
}

.scroll .popup_lsdl {
    background-color: #f8f9fb;
    margin: 20px
}

.scroll .popup_lsdl .popup_input {
    display: -webkit-flex;
    display: flex;
    margin-top: 30rpx
}

.scroll .popup_lsdl .popup_input .input-item-detail {
    background-color: #f8f8f8;
    border: 1px solid #c0ccda;
    color: #999;
    -webkit-flex: 1;
    flex: 1;
    font-size: 32rpx;
    font-weight: 400;
    height: 80rpx;
    padding-left: 30rpx;
    text-align: left
}

.scroll .popup_lsdl .popup_input .popup_button {
    width: 240rpx
}

.scroll .popup_lsdl .popup_button {
    border-radius: 0;
    font-size: 32rpx;
    height: 84rpx;
    line-height: 84rpx
}

.bottom-view {
    background: #fff;
    border: 1px solid #e1e1e1;
    bottom: 0;
    box-shadow: 0 2px 20px 0 hsla(0,0%,56%,.2);
    left: 0;
    padding-bottom: 20rpx;
    position: fixed;
    right: 0;
    width: 750rpx;
    z-index: 90
}

.bottom-view .rule-button {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    margin-bottom: 30rpx;
    padding: 20rpx 20rpx 0
}

.bottom-view .rule-image {
    height: 40rpx;
    width: 60rpx
}

.bottom-view .rule-text {
    color: #333;
    font-size: 26rpx;
    margin-left: 10rpx;
    white-space: pre-wrap
}

.bottom-view .next-button {
    background: #4e86f7;
    border-radius: 10px;
    box-shadow: 0 10px 18px 2px rgba(78,134,247,.2);
    color: #fff;
    font-size: 28rpx;
    height: 88rpx;
    line-height: 88rpx;
    margin: 0 10rpx;
    text-align: center
}
