.scroll {
    -webkit-flex: 1;
    flex: 1;
    height: 1rpx
}

.scroll .jsy-section {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 90rpx
}

.scroll .jsy-section .jsy-line {
    background: #4e86f7;
    height: 30rpx;
    width: 6rpx
}

.scroll .jsy-section .jsy-title {
    color: #333;
