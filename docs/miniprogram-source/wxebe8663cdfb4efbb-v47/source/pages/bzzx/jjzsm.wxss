wx-az .content {
    -webkit-flex: 1;
    flex: 1
}

.time-text {
    color: #333;
    font-size: 28rpx;
    margin-bottom: 20rpx;
    margin-left: 10rpx;
    white-space: pre-wrap
}

.bottom-view {
    background: #fff;
    border: 1px solid #e1e1e1;
    bottom: 0;
    box-shadow: 0 2px 20px 0 hsla(0,0%,56%,.2);
    box-sizing: border-box;
    left: 0;
    padding: 20rpx;
    position: fixed;
    right: 0;
    width: 750rpx;
    z-index: 999999
}

.bottom-view .rule-button {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    margin-bottom: 30rpx
}

.bottom-view .rule-image {
    height: 40rpx;
    width: 60rpx
}

.bottom-view .rule-text {
    color: #333;
    font-size: 28rpx;
    margin-left: 10rpx;
    white-space: pre-wrap
}

.bottom-view .next-button {
    background: #4e86f7;
    border-radius: 10px;
    box-shadow: 0 10px 18px 2px rgba(78,134,247,.2);
    color: #fff;
    font-size: 28rpx;
    height: 88rpx;
    line-height: 88rpx;
    margin: 0 10rpx;
    text-align: center
}

.bottom-view .disabled-button {
    background: #909399
}

.bottom-view .cover-text {
    color: red;
    display: inline-block;
    width: 80rpx
}
