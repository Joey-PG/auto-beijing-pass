.progress-view {
    background: #fff;
    box-shadow: 0 0 10px 1px rgba(86,95,104,.15);
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.progress-view .progress-image {
    height: 74rpx;
    margin: 30rpx 40rpx
}

.scroll {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 1rpx
}

.scroll .tip1 {
    color: #666;
    font-size: 24rpx;
    font-weight: 400;
    margin-top: 68rpx
}

.scroll .tip2 {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    margin-top: 50rpx
}

.scroll .tip2 .tip2-image {
    height: 24rpx;
    width: 24rpx
}

.scroll .tip2 .tip2-text {
    color: #4e86f7;
    font-size: 24rpx;
    font-weight: 400;
    margin-left: 10rpx
}

.scroll .cer-type-item {
    border-radius: 10rpx;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-top: 20rpx;
    position: relative
}

.scroll .cer-type-item.actived {
    border: 1rpx solid #4e86f7;
    box-shadow: 0 0 20px 0 rgba(78,134,247,.2)
}

.scroll .cer-type-item .cer-type-item-content {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff;
    border-radius: 10rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 205rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 670rpx
}

.scroll .cer-type-item .cer-type-item-content .cer-type-title {
    color: #333;
    font-size: 32rpx;
    font-weight: 400
}

.scroll .cer-type-item .cer-type-item-content .cer-type-title-selected {
    color: #4e86f7
}

.scroll .cer-type-item .cer-type-item-content .cer-type-desc {
    color: #666;
    font-size: 24rpx;
    font-weight: 400;
    margin-top: 20rpx;
    padding: 0 30rpx;
    text-align: center
}

.scroll .cer-type-item .cer-type-item-content .cer-type-desc .todetail {
    color: #4e86f7;
    display: inline-block;
    font-size: 24rpx
}

.scroll .cer-type-item .cer-type-item-content .text-disable {
    color: #999
}

.scroll .cer-type-item .hphm-item-selected {
    bottom: -10rpx;
    position: absolute;
    right: 0
}

.scroll .cer-type-item .item_image_selected {
    height: 60rpx;
    width: 75rpx
}

.scroll .cer-type-item .item-view-disable {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: flex-end;
    justify-content: flex-end;
    position: absolute;
    right: 0;
    top: 0
}

.scroll .cer-type-item .item-view-disable-image {
    height: 100rpx;
    width: 200rpx
}

.scroll .cer-type-item .item-view-disable-text {
    color: #fff;
    font-size: 24rpx;
    font-weight: 400;
    height: 50rpx;
    margin-left: -100rpx;
    margin-top: 10rpx;
    width: 100rpx
}

.next-button {
    -webkit-align-items: center;
    align-items: center;
    background: #4e86f7;
    border-radius: 10px;
    box-shadow: 0 10px 18px 2px rgba(78,134,247,.2);
    display: -webkit-flex;
    display: flex;
    height: 88rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 40rpx
}

.next-button .next-text {
    color: #fff;
    font-size: 28rpx;
    font-weight: 400
}
