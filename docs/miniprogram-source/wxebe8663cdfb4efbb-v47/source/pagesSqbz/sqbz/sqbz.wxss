.popup-container {
    background: #fff;
    border-radius: 10rpx;
    box-shadow: 0rpx 2rpx 20rpx 0rpx hsla(0,0%,56%,.2);
    box-sizing: border-box;
    padding: 0 40rpx 40rpx;
    width: 590rpx
}

.popup-title {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    font-size: 32rpx;
    height: 88rpx;
    -webkit-justify-content: center;
    justify-content: center
}

.popup-text,.popup-title {
    color: #333;
    font-weight: 400
}

.popup-text {
    color: #999;
    font-size: 28rpx;
    text-indent: 45rpx
}

.popup-button {
    background: #4e86f7;
    color: #fff;
    height: 80rpx;
    margin: 40rpx 0 0
}

.disabledBtn {
