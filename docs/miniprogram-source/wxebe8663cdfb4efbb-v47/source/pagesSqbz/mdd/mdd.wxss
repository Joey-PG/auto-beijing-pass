.item {
    background: #fff;
    margin-top: 20rpx
}

.item .seperator {
    margin-left: 0rpx
}

.item .seperator,.item .seperator-line {
    background-color: #e1e1e1;
    height: 1rpx;
    margin-right: 0rpx
}

.item .seperator-line {
    margin-left: 30rpx
}

.item .important-text {
    color: #df3d33
}

.item .title-text {
    color: #333;
    font-size: 28rpx;
    font-weight: 400;
    line-height: 90rpx;
    margin-left: 30rpx;
    width: 160rpx
}

.item .detail-text,.item .input-item-detail {
    color: #999;
    -webkit-flex: 1;
    flex: 1;
    font-size: 28rpx;
    font-weight: 400;
    text-align: right
}

.item .input-item-detail {
    margin-right: 30rpx;
    text-overflow: ellipsis
}

.item .forward {
    margin-left: 15rpx;
    margin-right: 30rpx
}

.item .map-item,.item .select-item {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row
}

.item .map-item {
    height: 88rpx;
    -webkit-justify-content: flex-end;
    justify-content: flex-end
}

.item .location {
    height: 50rpx;
    margin-right: 40rpx;
    padding: 20rpx;
    width: 50rpx
}

.next-button {
    -webkit-align-items: center;
    align-items: center;
    background: #4e86f7;
    border-radius: 10px;
    box-shadow: 0 10px 18px 2px rgba(78,134,247,.2);
    display: -webkit-flex;
    display: flex;
    height: 88rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 40rpx
}

.next-button .next-text {
    color: #fff;
    font-size: 28rpx;
    font-weight: 400
}
