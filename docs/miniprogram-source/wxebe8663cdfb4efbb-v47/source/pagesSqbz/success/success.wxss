.container {
    box-sizing: border-box;
    padding-top: 95rpx
}

.container .top {
    text-align: center
}

.container .top .img {
    height: 189rpx;
    width: 189rpx
}

.container .top .title {
    color: #4e86f7;
    font-family: PingFang SC;
    font-size: 36rpx;
    font-weight: 500;
    margin-bottom: 20rpx;
    margin-top: 57rpx
}

.container .top .waiter {
    font-size: 28rpx;
    margin-bottom: 71rpx
}

.container .top .btn {
    background: #4e86f7;
    border-radius: 10px;
    box-shadow: 0 10px 18px 2px rgba(78,134,247,.2);
    color: #fcfefc;
    height: 88rpx;
    line-height: 88rpx;
    margin: 0 auto 60rpx;
    width: 670rpx
}

.container .bottom,.container .top .btn {
    font-family: PingFang SC;
    font-size: 28rpx;
    font-weight: 400
}

.container .bottom {
    color: #de4545;
    line-height: 44rpx;
    margin: 0 54rpx
}

.container .bottom .content {
    text-indent: 20rpx
}

.container .border-content {
    border: 1rpx solid #333;
    border-radius: 10rpx;
    color: #333;
    font-size: 22rpx;
    margin: 20rpx 34rpx 0;
    padding: 5px
}
