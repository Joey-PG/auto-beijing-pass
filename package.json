  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@inquirer/prompts": "^8.3.2",
    "antd": "5.29.3",
    "commander": "^14.0.3",
    "jimp": "^1.6.1",
    "onnxruntime-node": "^1.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/node": "22.19.15",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
