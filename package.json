{
  "name": "auto-beijing-pass",
  "version": "1.0.2",
  "description": "进京证 CLI 工具 - 让人类和 AI Agent 都能在终端中办理进京证",
  "type": "module",
  "bin": {
    "auto-bj-pass": "bin/auto-bj-pass.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "web": "node bin/auto-bj-pass.js web",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts"
  },
  "files": [
    "bin/",
    "src/",
    "models/",
    "skills/",
    "KNOWN_ISSUES.md"
